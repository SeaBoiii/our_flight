# SHA-256 hex digests only. Never place a raw invitation code here.
VITE_INVITE_CODE_HASH_ECONOMY=
VITE_INVITE_CODE_HASH_PREMIUM=
VITE_INVITE_CODE_HASH_BUSINESS=
VITE_INVITE_CODE_HASH_FIRST=
VITE_INVITE_CODE_HASH_BRIDE_ECONOMY=
VITE_INVITE_CODE_HASH_BRIDE_PREMIUM=
VITE_INVITE_CODE_HASH_BRIDE_BUSINESS=
VITE_INVITE_CODE_HASH_BRIDE_FIRST=

# Compatibility defaults off. Populate the legacy values only during migration.
VITE_LEGACY_INVITES_ENABLED=false
# VITE_PASSCODE_HASH=
# VITE_INVITE_HASH_ECONOMY=
# VITE_INVITE_HASH_PREMIUM=
# VITE_INVITE_HASH_BUSINESS=
# VITE_INVITE_HASH_FIRST=

# Keep preview until the Google Apps Script bridge has been authorised and tested.
VITE_RSVP_STATUS=preview
VITE_APPS_SCRIPT_URL=

# Optional local overrides. The Pages workflow defaults to this custom-domain root.
# Without workflow overrides, Actions builds fall back to the github.io repository URL.
# VITE_BASE_PATH=/
# VITE_PUBLIC_SITE_URL=https://rsvp.aleemxnurul.love/
