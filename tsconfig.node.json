{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true
  },
  "include": [
    "vite.config.ts", "playwright.config.ts", "e2e/**/*.ts", "plugins/**/*.ts",
    "src/calendar.ts", "src/invitationEvents.ts", "src/programme.ts", "src/types.ts"
  ]
}
